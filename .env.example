# Copy to .env (or export) for local development. Every setting has a safe local default.

# --- core --------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the app (links in emails, allowed CSRF origin). On Render this defaults to
# RENDER_EXTERNAL_URL automatically.
APP_URL=http://localhost:4000
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0

# --- data --------------------------------------------------------------------------------
DATABASE_URL=postgres://agentforge:agentforge@localhost:5432/agentforge
DATABASE_SSL=disable            # disable | require | verify
REDIS_URL=redis://localhost:6379
BLOB_STORAGE=filesystem         # filesystem | postgres (use postgres on hosts with ephemeral disks)
BLOB_STORAGE_DIR=./storage

# --- AI ----------------------------------------------------------------------------------
# fake = deterministic demo model (no key, no cost). anthropic = Claude.
LLM_PROVIDER=fake
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# hashing = deterministic local embeddings. openai-compatible = any /v1/embeddings server.
EMBEDDING_PROVIDER=hashing
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=mxbai-embed-large
# EMBEDDING_API_KEY=

# --- single-instance hosting ---------------------------------------------------------------
SERVE_WEB=false                 # true: this process also serves the built Next.js app
MIGRATE_ON_START=false
SEED_ON_START=false
SELF_PING=false

# --- limits ------------------------------------------------------------------------------
MAX_ACTIVE_RUNS_PER_ORG=5
DAILY_TOKEN_BUDGET_PER_ORG=2000000
