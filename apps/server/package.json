{
  "name": "@agentforge/server",
  "version": "0.1.0",
  "private": true,
  "description": "AgentForge API, background worker and CLI: one codebase, several entry points.",
  "type": "module",
  "scripts": {
    "dev": "SERVE_WEB=true WEB_DIR=../web tsx watch --clear-screen=false --exclude '../web/**' src/main/all-in-one.ts",
    "dev:api": "tsx watch --clear-screen=false src/main/api.ts",
    "dev:worker": "tsx watch --clear-screen=false src/main/worker.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/all-in-one.js",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/main/cli.ts migrate",
    "db:seed": "tsx src/main/cli.ts seed",
    "evals": "tsx src/main/cli.ts evals",
    "openapi:export": "tsx src/main/cli.ts openapi"
  },
  "dependencies": {
    "@agentforge/contracts": "workspace:*",
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@node-rs/argon2": "^2.2.1",
    "@scalar/fastify-api-reference": "^1.72.1",
    "ajv": "^8.20.0",
    "bullmq": "^6.3.9",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pgvector": "^0.3.0",
    "pino": "^10.3.1",
    "undici": "^8.11.2",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
